{
  "name": "cookster",
  "productName": "Cookster",
  "version": "1.0.0",
  "description": "Cookster - igrica kuvanja",
  "main": "main.js",
  "author": "milos1902",
  "license": "UNLICENSED",
  "scripts": {
    "prepare-app": "node prepare-app.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "rs.cookster.game",
    "productName": "Cookster",
    "files": ["main.js", "app/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "compression": "store"
  }
}
